# ----- 数据库 -----
DATABASE_URL="file:./dev.db"
# 生产（postgres）：DATABASE_URL="postgresql://user:pass@localhost:5432/ielts"

# ----- 会话 -----
# 至少 32 字节，可用：openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# ----- AI Provider 切换（每个能力可独立配置）-----
# text: openai | anthropic | ollama
AI_TEXT_PROVIDER="openai"
# voice (TTS): openai | (未来) elevenlabs
AI_VOICE_PROVIDER="openai"
# stt: openai
AI_STT_PROVIDER="openai"
# realtime (口语实时): openai
AI_REALTIME_PROVIDER="openai"

# ----- OpenAI（兼容任意 OpenAI 风格网关，如 tokenrhythm / deepseek / airouter）-----
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
# 文本能力(chat/chatJSON)专用凭据：留空则回落到上面的通用 OPENAI_*。
# 用途：文本走第三方网关，语音/口语仍走官方 OpenAI。
# 网关需支持 GET /v1/models，设置页可在线拉取并选择模型（存到用户 Profile，覆盖下面默认值）。
OPENAI_TEXT_API_KEY=""
OPENAI_TEXT_BASE_URL=""
OPENAI_TEXT_MODEL="deepseek-v4-flash"
OPENAI_TTS_MODEL="tts-1"
OPENAI_TTS_VOICE="shimmer"
OPENAI_STT_MODEL="whisper-1"
OPENAI_REALTIME_MODEL="gpt-4o-realtime-preview"

# ----- Anthropic（可选，切换文本 provider 时启用）-----
ANTHROPIC_API_KEY=""
ANTHROPIC_TEXT_MODEL="claude-sonnet-4-6"

# ----- Ollama（可选，本地模型）-----
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_TEXT_MODEL="qwen2.5:7b"

# ----- 应用 -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
