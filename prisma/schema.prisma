// IELTS Study — Prisma Schema
// dev: SQLite  |  prod: Postgres (只需切换 provider + DATABASE_URL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ 用户 ============
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  createdAt     DateTime  @default(now())
  profile       Profile?
  assessments   Assessment[]
  plan          Plan?
  vocabProgress VocabProgress[]
  attempts      Attempt[]
  writings      WritingSubmission[]
  speakingLogs  SpeakingSession[]
  wordBooks     WordBook[]
  favorites     FavoriteWord[]
  dictations    DictationAttempt[]
  mistakes      MistakeWord[]
}

model Profile {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetOverall   Float?
  targetListening Float?
  targetReading   Float?
  targetWriting   Float?
  targetSpeaking  Float?
  examDate        DateTime?
  weeklyHours     Int?
  currentBand     String?   // JSON: { listening, reading, writing, speaking, vocab }
  dailyNewWords   Int?      // 每日新词数（50-100，默认 50）
  dailyReviewWords Int?     // 每日复习上限（= dailyNewWords × reviewRatio，冗余存储）
  reviewRatio     Int       @default(2) // 复习:新词 配比（2 或 3，即 1:2 / 1:3）
  vocabBook       String?   // 锁定词书（如 ielts/toefl/cet6），null=全部词库
  aiBaseUrl       String?   // 用户自定义文本网关 Base URL（覆盖 env），null=用 env
  aiApiKey        String?   // 用户自定义文本网关 API Key（覆盖 env），null=用 env
  aiTextModel     String?   // 用户在设置页选择的文本模型（覆盖 env 默认），null=用 env
  updatedAt       DateTime  @updatedAt
}

// ============ 评估 ============
model Assessment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // initial | checkpoint
  results   String   // JSON
  bands     String   // JSON: { listening, reading, writing, speaking, vocab }
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ============ 学习规划 ============
model Plan {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  weeks     WeekPlan[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model WeekPlan {
  id        String     @id @default(cuid())
  planId    String
  plan      Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekIndex Int
  focus     String     // JSON: { listening: hours, reading: hours, ... }
  tasks     DailyTask[]

  @@index([planId, weekIndex])
}

model DailyTask {
  id          String    @id @default(cuid())
  weekPlanId  String
  weekPlan    WeekPlan  @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  date        DateTime
  module      String    // vocab | reading | listening | writing | speaking
  content     String    // JSON
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@index([weekPlanId, date])
}

// ============ 词汇 ============
model Word {
  id           String  @id @default(cuid())
  spelling     String  @unique
  ipa          String?
  translations String  // JSON [{pos, meaning}]
  examples     String  // JSON [{en, zh}]
  level        Int     // 3000/5000/7000/8500
  tags         String  // 逗号分隔
  freq         Int     @default(0) // 剑桥真题考频（由 scripts/build-book-vocab.ts 统计）
  defEn        String? // 英文释义
  etymology    String? // JSON [{part, meaning}] 词根词缀拆解
  derivatives  String? // JSON [{word, pos, meaning}] 派生词
  mnemonic     String? // 助记
  story        String? // JSON {en, zh} AI 小故事
  progress     VocabProgress[]
  chapters     ChapterWord[]
  favorites    FavoriteWord[]
  mistakes     MistakeWord[]
}

model VocabProgress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId     String
  word       Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  stability  Float    @default(0)
  difficulty Float    @default(5)
  dueAt      DateTime @default(now())
  reps       Int      @default(0)
  lapses     Int      @default(0)
  lastGrade  Int?     // 0-4 (again/hard/good/easy/perfect)
  updatedAt  DateTime @updatedAt

  @@unique([userId, wordId])
  @@index([userId, dueAt])
}

// ============ 词书 ============
model WordBook {
  id          String        @id @default(cuid())
  slug        String        @unique // 官方词书自然键(ielts-reading/ielts-listening) / 自定义词书随机
  title       String
  description String?
  kind        String        // official | custom
  userId      String?       // custom 词书所属用户，official 为 null
  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  chapters    WordChapter[]

  @@index([kind])
  @@index([userId])
}

model WordChapter {
  id       String        @id @default(cuid())
  bookId   String
  book     WordBook      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  index    Int
  title    String
  subtitle String?       // 如 passage 标题 / 来源说明
  words    ChapterWord[]

  @@unique([bookId, index])
}

model ChapterWord {
  id        String      @id @default(cuid())
  chapterId String
  chapter   WordChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  wordId    String
  word      Word        @relation(fields: [wordId], references: [id], onDelete: Cascade)
  index     Int         // 章节内排序（按考频降序）
  freq      Int         // 该章节内出现频次

  @@unique([chapterId, wordId])
  @@index([wordId])
}

// ============ 生词本 / 听写 / 错词 ============
model FavoriteWord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId    String
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, wordId])
  @@index([userId, createdAt])
}

model DictationAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String   // book | chapter | mistakes | favorites | random
  scopeId   String?  // bookId / chapterId
  total     Int
  correct   Int
  accuracy  Float
  duration  Int      // 秒
  mistakes  String   // JSON: [wordId]
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model MistakeWord {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId      String
  word        Word      @relation(fields: [wordId], references: [id], onDelete: Cascade)
  source      String    // dictation | study | spell | sentence
  wrongAnswer String?
  count       Int       @default(1)
  lastWrongAt DateTime  @default(now())
  mastered    Boolean   @default(false)

  @@unique([userId, wordId])
  @@index([userId, mastered, lastWrongAt])
}

// ============ 阅读 / 听力题库 ============
model Passage {
  id         String     @id @default(cuid())
  source     String     // cambridge-9-test-1-passage-1 | ai-<id>
  module     String     // reading | listening
  title      String
  content    String
  audioPath  String?
  metadata   String     // JSON: {difficulty, wordCount, topics}
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  questions  Question[]

  @@index([module, active])
}

model Question {
  id          String    @id @default(cuid())
  passageId   String
  passage     Passage   @relation(fields: [passageId], references: [id], onDelete: Cascade)
  index       Int
  type        String    // tfng | mcq | matching | gapfill | heading
  prompt      String
  options     String?   // JSON
  answer      String    // JSON
  explanation String?
  attempts    Attempt[]

  @@index([passageId, index])
}

model Attempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passageId  String
  questionId String?
  question   Question? @relation(fields: [questionId], references: [id])
  answers    String   // JSON: { [questionId]: userAnswer }
  score      Float
  band       Float?
  duration   Int      // 秒
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// ============ 写作 ============
model WritingPrompt {
  id          String   @id @default(cuid())
  task        String   // task1 | task2
  category    String   // chart | line | pie | argument | discuss | ...
  prompt      String
  imageUrl    String?
  minWords    Int      @default(250)
  timeMinutes Int      @default(40)
  active      Boolean  @default(true)
  submissions WritingSubmission[]
}

model WritingSubmission {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptId  String
  prompt    WritingPrompt @relation(fields: [promptId], references: [id])
  content   String
  wordCount Int
  duration  Int
  scores    String        // JSON: {tr, cc, lr, gra, overall}
  feedback  String        // JSON
  provider  String?       // 记录批改用的 AI provider
  model     String?
  createdAt DateTime      @default(now())

  @@index([userId, createdAt])
}

// ============ 口语 ============
model SpeakingPrompt {
  id        String   @id @default(cuid())
  part      Int      // 1 | 2 | 3
  topic     String
  question  String
  followUps String?  // JSON
  active    Boolean  @default(true)
}

model SpeakingSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  part       Int
  promptIds  String   // JSON
  transcript String   // JSON [{role, text, ts}]
  audioPath  String?
  scores     String   // JSON
  feedback   String   // JSON
  provider   String?
  model      String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// ============ AI 调用日志（成本 / 排障）============
model AILog {
  id        String   @id @default(cuid())
  userId    String?
  provider  String
  model     String
  kind      String   // chat | tts | stt | realtime
  purpose   String   // writing-grade | speaking-grade | content-gen | ...
  inputTokens  Int?
  outputTokens Int?
  latencyMs Int?
  ok        Boolean  @default(true)
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}
